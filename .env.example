# Copy this file to .env.local and fill in real values.
#
# JWT_SECRET — secret used to sign session tokens.
#   REQUIRED in production; the app refuses to start without it.
#   In development it's optional (a random per-process secret is generated,
#   though sessions won't survive a restart without a stable value).
#   Generate a strong value with: openssl rand -hex 32
JWT_SECRET=
